<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moonlight SDK 简化测试"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- 状态显示区域 -->
    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="等待测试..."
        android:textSize="12sp"
        android:padding="8dp"
        android:background="#f0f0f0"
        android:layout_marginBottom="16dp"
        android:scrollbars="vertical" />

    <!-- 测试按钮 -->
    <Button
        android:id="@+id/test_root_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="测试 Root 检测"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/test_sdk_init_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="测试 SDK 初始化"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/clear_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="清除日志"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/start_game_stream_test_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="启动 GameStream SDK 测试"
        android:layout_marginBottom="8dp" />

    <!-- 说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="测试功能：\n1. RootChecker 类加载和功能\n2. WsLightSDK 类加载\n3. 基本依赖验证\n4. GameStream SDK 功能测试"
        android:textSize="12sp"
        android:padding="8dp"
        android:background="#e0ffe0"
        android:layout_marginTop="16dp" />

</LinearLayout>